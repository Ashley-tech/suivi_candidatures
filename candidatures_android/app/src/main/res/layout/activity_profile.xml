<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ProfileActivity">

    <TextView
        android:id="@+id/logotitleprofile"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Suivi des candidatures"
        android:textColor="@color/red"
        android:textSize="25dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/titleprofile"/>

    <TextView
        android:id="@+id/titleprofile"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Vos informations"
        android:textColor="@color/black"
        android:textSize="15dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/logotitleprofile"
        app:layout_constraintBottom_toTopOf="@id/sexe_text"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/sexe_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Sexe : "
        android:textColor="@color/black"
        android:layout_marginStart="6dp"
        app:layout_constraintTop_toBottomOf="@id/titleprofile"
        app:layout_constraintEnd_toStartOf="@id/ln_text"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toTopOf="@id/fn_text" />

    <TextView
        android:id="@+id/ln_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="6dp"
        android:text="Nom : "
        android:textColor="@color/black"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/sexe_text"
        app:layout_constraintTop_toBottomOf="@id/titleprofile"
        app:layout_constraintBottom_toTopOf="@id/email_text" />

    <TextView
        android:id="@+id/fn_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Prénom : "
        android:textColor="@color/black"
        android:layout_marginStart="6dp"
        app:layout_constraintTop_toBottomOf="@id/sexe_text"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/mdp_text"
        app:layout_constraintBottom_toTopOf="@id/dn_text" />

    <TextView
        android:id="@+id/email_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Email : "
        android:textColor="@color/black"
        android:layout_marginEnd="6dp"
        app:layout_constraintTop_toBottomOf="@id/ln_text"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/fn_text"
        app:layout_constraintBottom_toTopOf="@id/mdp_text" />

    <TextView
        android:id="@+id/dn_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Date de naissance : "
        android:textColor="@color/black"
        android:layout_marginEnd="6dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/fn_text"
        android:layout_marginStart="6dp"
        app:layout_constraintEnd_toStartOf="@id/mdp_text"
        app:layout_constraintBottom_toTopOf="@id/nationalite_text"/>

    <TextView
        android:id="@+id/mdp_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Mot de passe : "
        android:layout_marginEnd="6dp"
        android:layout_marginStart="6dp"
        android:textColor="@color/black"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/dn_text"
        app:layout_constraintTop_toBottomOf="@id/email_text"
        app:layout_constraintBottom_toTopOf="@id/titre_text" />

    <TextView
        android:id="@+id/nationalite_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Nationalité : "
        android:layout_marginStart="6dp"
        android:textColor="@color/black"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/titre_text"
        app:layout_constraintTop_toBottomOf="@id/dn_text"
        app:layout_constraintBottom_toTopOf="@id/adresse_text" />

    <TextView
        android:id="@+id/titre_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Situation actuelle : "
        android:layout_marginEnd="6dp"
        android:textColor="@color/black"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/nationalite_text"
        app:layout_constraintBottom_toTopOf="@id/adresse_comp_text"
        app:layout_constraintTop_toBottomOf="@id/mdp_text" />

    <TextView
        android:id="@+id/adresse_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Adresse : "
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp"
        android:textColor="@color/black"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/adresse_comp_text"
        app:layout_constraintBottom_toTopOf="@id/code_postal_text"
        app:layout_constraintTop_toBottomOf="@id/nationalite_text" />

    <TextView
        android:id="@+id/adresse_comp_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Complément d'adresse : "
        android:layout_marginEnd="6dp"
        android:layout_marginStart="6dp"
        android:textColor="@color/black"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/adresse_text"
        app:layout_constraintBottom_toTopOf="@id/ville_text"
        app:layout_constraintTop_toBottomOf="@id/titre_text" />

    <TextView
        android:id="@+id/code_postal_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Code postal : "
        android:layout_marginStart="6dp"
        android:textColor="@color/black"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/ville_text"
        app:layout_constraintBottom_toTopOf="@id/pays_text"
        app:layout_constraintTop_toBottomOf="@id/adresse_text"
     />

    <TextView
        android:id="@+id/ville_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Ville : "
        android:layout_marginEnd="6dp"
        android:textColor="@color/black"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/code_postal_text"
        app:layout_constraintTop_toBottomOf="@id/adresse_comp_text"
        app:layout_constraintBottom_toTopOf="@id/tel_text" />

    <TextView
        android:id="@+id/pays_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Pays : "
        android:textColor="@color/black"
        android:layout_marginStart="6dp"
        app:layout_constraintBottom_toTopOf="@+id/website_text"
        app:layout_constraintEnd_toStartOf="@+id/tel_text"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/code_postal_text"/>

    <TextView
        android:id="@+id/tel_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Numéro de téléphone : "
        android:textColor="@color/black"
        android:layout_marginEnd="6dp"
        app:layout_constraintBottom_toTopOf="@+id/date_creation_text"
        app:layout_constraintStart_toEndOf="@id/pays_text"
        app:layout_constraintTop_toBottomOf="@id/ville_text"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/website_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Site web : "
        android:textColor="@color/black"
        app:layout_constraintEnd_toStartOf="@+id/date_creation_text"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="6dp"
        app:layout_constraintTop_toBottomOf="@id/pays_text"
        app:layout_constraintBottom_toTopOf="@id/profile_to_form_button" />

    <TextView
        android:id="@+id/date_creation_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Date de création du compte : "
        android:layout_marginEnd="6dp"
        android:textColor="@color/black"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/website_text"
        app:layout_constraintBottom_toTopOf="@id/profile_to_confirm_logout_button"
        app:layout_constraintTop_toBottomOf="@id/tel_text" />

    <Button
        android:id="@+id/profile_to_form_button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Modifier les informations"
        android:backgroundTint="@color/red"
        android:textColor="@color/white"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toTopOf="@id/profile_to_confirm_da_button"
        app:layout_constraintTop_toBottomOf="@id/website_text"
        app:layout_constraintEnd_toStartOf="@id/profile_to_cvs_button"
         />

    <Button
        android:id="@+id/profile_to_cvs_button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Vos CVs"
        android:backgroundTint="@color/red"
        android:textColor="@color/white"
        app:layout_constraintEnd_toStartOf="@id/profile_to_confirm_logout_button"
        app:layout_constraintStart_toEndOf="@id/profile_to_form_button"
        app:layout_constraintBottom_toTopOf="@id/profile_to_menu_button"
        app:layout_constraintTop_toBottomOf="@id/date_creation_text" />

    <Button
        android:id="@+id/profile_to_confirm_logout_button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Se déconnecter"
        android:backgroundTint="@color/red"
        android:textColor="@color/white"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/profile_to_cvs_button"
        app:layout_constraintBottom_toTopOf="@id/profile_to_menu_button"
        app:layout_constraintTop_toBottomOf="@id/date_creation_text"
        />

    <Button
        android:id="@+id/profile_to_confirm_da_button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Supprimer mon compte"
        android:backgroundTint="@color/red"
        android:textColor="@color/white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/profile_to_menu_button"
        app:layout_constraintTop_toBottomOf="@id/profile_to_form_button"/>

    <Button
        android:id="@+id/profile_to_menu_button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Retour"
        android:backgroundTint="@color/red"
        android:textColor="@color/white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/profile_to_confirm_da_button"
        app:layout_constraintTop_toBottomOf="@id/profile_to_confirm_logout_button"/>
</androidx.constraintlayout.widget.ConstraintLayout>