<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ModifyCandidatureActivity">

    <TextView
        android:id="@+id/logotitlemodifycandidature"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Suivi des candidatures"
        android:textColor="@color/red"
        android:textSize="25dp"
        app:layout_constraintBottom_toTopOf="@id/titlemodifycandidature"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/titlemodifycandidature"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Modification de la candidature"
        android:textColor="@color/black"
        android:textSize="15dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/logotitlemodifycandidature"
        app:layout_constraintBottom_toTopOf="@id/type_candidature_spinner_2"/>

    <Spinner
        android:id="@+id/type_candidature_spinner_2"
        android:layout_width="0dp"
        android:layout_height="47dp"
        android:entries="@array/type_candidature_list"
        app:layout_constraintBottom_toTopOf="@id/details_input_2"
        app:layout_constraintEnd_toStartOf="@id/titre_candidature_input_2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/titlemodifycandidature"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp"/>

    <EditText
        android:id="@+id/titre_candidature_input_2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:ems="10"
        android:inputType="text"
        android:hint="Titre de l'offre* :"
        app:layout_constraintStart_toEndOf="@id/type_candidature_spinner_2"
        app:layout_constraintTop_toBottomOf="@id/titlemodifycandidature"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/details_input_2"/>

    <EditText
        android:id="@+id/details_input_2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:ems="10"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp"
        android:gravity="top|start"
        android:hint="Description de l'offre"
        android:inputType="textMultiLine"
        android:maxLines="5"
        android:minLines="3"
        app:layout_constraintTop_toBottomOf="@id/titre_candidature_input_2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/nom_entreprise_input_2"/>

    <EditText
        android:id="@+id/nom_entreprise_input_2"
        android:layout_width="0dp"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp"
        android:layout_height="wrap_content"
        android:ems="10"
        android:inputType="text"
        android:hint="Entreprise :"
        app:layout_constraintBottom_toTopOf="@id/cp_ville_pays_entreprise_input_2"
        app:layout_constraintTop_toBottomOf="@id/details_input_2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/adresse_entreprise_input_2"/>

    <EditText
        android:id="@+id/adresse_entreprise_input_2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:ems="10"
        android:hint="[Adresse]/[Complément]"
        android:inputType="text"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/nom_entreprise_input_2"
        app:layout_constraintTop_toBottomOf="@id/details_input_2"
        app:layout_constraintBottom_toTopOf="@id/date_candidature_input_2"/>

    <EditText
        android:id="@+id/cp_ville_pays_entreprise_input_2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp"
        android:ems="10"
        android:hint="[Code]/[Ville]/[Pays]"
        android:inputType="text"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/nom_entreprise_input_2"
        app:layout_constraintEnd_toStartOf="@id/date_candidature_input_2"
        app:layout_constraintBottom_toTopOf="@id/nom_prenom_recruteur_input_2"/>

    <EditText
        android:id="@+id/date_candidature_input_2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:ems="10"
        android:layout_marginStart="6dp"
        android:hint="Date de candidature"
        android:inputType="date"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/cp_ville_pays_entreprise_input_2"
        app:layout_constraintTop_toBottomOf="@+id/adresse_entreprise_input_2"
        app:layout_constraintBottom_toTopOf="@id/nom_prenom_recruteur_input_2"/>

    <EditText
        android:id="@+id/statut_input_2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp"
        android:ems="10"
        android:hint="Statut"
        android:inputType="text"
        app:layout_constraintBottom_toTopOf="@+id/email_tel_recruteur_input_2"
        app:layout_constraintEnd_toStartOf="@id/nom_prenom_recruteur_input_2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cp_ville_pays_entreprise_input_2" />

    <EditText
        android:id="@+id/nom_prenom_recruteur_input_2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:ems="10"
        android:hint="[Nom]/[Prénom du recruteur]"
        android:inputType="textEmailAddress"
        app:layout_constraintBottom_toTopOf="@+id/periode_input_2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/statut_input_2"
        app:layout_constraintTop_toBottomOf="@+id/date_candidature_input_2" />

    <EditText
        android:id="@+id/email_tel_recruteur_input_2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:ems="10"
        android:hint="[Email]/[Téléphone du recruteur]"
        android:inputType="text"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp"
        app:layout_constraintEnd_toStartOf="@id/periode_input_2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/statut_input_2"
        app:layout_constraintBottom_toTopOf="@id/salaire_min_input_2"
        tools:layout_editor_absoluteY="471dp" />

    <EditText
        android:id="@+id/periode_input_2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:ems="10"
        android:hint="Période :"
        android:layout_marginStart="6dp"
        android:inputType="text"
        app:layout_constraintStart_toEndOf="@id/email_tel_recruteur_input_2"
        app:layout_constraintBottom_toTopOf="@id/salaire_max_input_2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/nom_prenom_recruteur_input_2"
        tools:layout_editor_absoluteY="459dp" />

    <EditText
        android:id="@+id/salaire_min_input_2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:ems="10"
        android:hint="Salaire min :"
        android:layout_marginEnd="6dp"
        android:layout_marginStart="6dp"
        android:inputType="number"
        app:layout_constraintEnd_toStartOf="@id/salaire_max_input_2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toTopOf="@id/date_publication_input_2"
        app:layout_constraintTop_toBottomOf="@id/email_tel_recruteur_input_2"
        tools:layout_editor_absoluteY="519dp" />

    <EditText
        android:id="@+id/salaire_max_input_2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:ems="10"
        android:hint="Salaire max :"
        android:layout_marginStart="6dp"
        android:inputType="number"
        app:layout_constraintStart_toEndOf="@id/salaire_min_input_2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/periode_input_2"
        app:layout_constraintBottom_toTopOf="@id/cvs_spinner_2"
        tools:layout_editor_absoluteY="515dp" />

    <EditText
        android:id="@+id/date_publication_input_2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp"
        android:ems="10"
        android:hint="Date de publication :"
        android:inputType="date"
        app:layout_constraintBottom_toTopOf="@id/modify_candidature_button"
        app:layout_constraintTop_toBottomOf="@id/salaire_min_input_2"
        app:layout_constraintEnd_toStartOf="@id/cvs_spinner_2"
        app:layout_constraintStart_toStartOf="parent"
        tools:layout_editor_absoluteY="589dp" />

    <Spinner
        android:id="@+id/cvs_spinner_2"
        android:layout_width="0dp"
        android:layout_height="49dp"
        android:layout_marginStart="6dp"
        app:layout_constraintBottom_toTopOf="@id/modify_to_candidature_info_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/date_publication_input_2"
        app:layout_constraintTop_toBottomOf="@+id/salaire_max_input_2" />

    <Button
        android:id="@+id/modify_candidature_button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/red"
        android:text="Modifier la candidature"
        android:textColor="@color/white"
        app:layout_constraintTop_toBottomOf="@id/date_publication_input_2"
        app:layout_constraintEnd_toStartOf="@id/modify_to_candidature_info_button"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <Button
        android:id="@+id/modify_to_candidature_info_button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/red"
        android:text="Retour"
        android:textColor="@color/white"
        app:layout_constraintTop_toBottomOf="@id/cvs_spinner_2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/modify_candidature_button"
        app:layout_constraintBottom_toBottomOf="parent"
        tools:layout_editor_absoluteY="677dp" />

</androidx.constraintlayout.widget.ConstraintLayout>