<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ConfirmDeleteCandidatureActivity">

    <TextView
        android:id="@+id/logotitleconfirmdeletecandidature"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Suivi des candidatures"
        android:textColor="@color/red"
        android:textSize="25dp"
        app:layout_constraintBottom_toTopOf="@+id/titleconfirmdeletecandidature"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/titleconfirmdeletecandidature"
        android:layout_width="0dp"
        android:textAlignment="center"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp"
        android:layout_height="wrap_content"
        android:text="Êtes-vous sûr de vouloir supprimer cette candidature ?"
        android:textSize="15dp"
        app:layout_constraintTop_toBottomOf="@id/logotitleconfirmdeletecandidature"
        app:layout_constraintBottom_toTopOf="@+id/delete_candidature_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <Button
        android:id="@+id/delete_candidature_button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/red"
        android:text="Oui"
        android:textColor="@color/white"
        app:layout_constraintTop_toBottomOf="@id/titleconfirmdeletecandidature"
        app:layout_constraintBottom_toTopOf="@+id/no_delete_candidature_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <Button
        android:id="@+id/no_delete_candidature_button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/red"
        android:text="Non"
        android:textColor="@color/white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/delete_candidature_button"/>
</androidx.constraintlayout.widget.ConstraintLayout>