<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ConfirmDeleteAccountActivity">

    <TextView
        android:id="@+id/logotitleconfirmdeletea"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Suivi des candidatures"
        android:textSize="25dp"
        android:textColor="@color/red"
        app:layout_constraintBottom_toTopOf="@id/titleconfirmdeletea"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/titleconfirmdeletea"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAlignment="center"
        android:textColor="@color/black"
        android:textSize="16dp"
        android:text="Êtes-vous sûr de vouloir supprimer votre compte ?\n Cette action est irréversible."
        app:layout_constraintTop_toBottomOf="@id/logotitleconfirmdeletea"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toTopOf="@id/delete_account_button"
        tools:layout_editor_absoluteY="257dp" />

    <Button
        android:id="@+id/delete_account_button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/red"
        android:text="Oui, supprimer mon compte"
        android:textColor="@color/white"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/titleconfirmdeletea"
        app:layout_constraintBottom_toTopOf="@id/no_delete_account_button"/>

    <Button
        android:id="@+id/no_delete_account_button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/red"
        android:text="Non, conserver mon compte"
        android:textColor="@color/white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/delete_account_button" />
</androidx.constraintlayout.widget.ConstraintLayout>